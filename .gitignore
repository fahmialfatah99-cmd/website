```gitignore
# Dependencies
node_modules/

# Environment variables
.env
.env.local
.env.*

# IDE files
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log

# Build artifacts
dist/
build/
target/

# Python cache
__pycache__/
*.pyc
*.pyo

# Temporary files
*.tmp
*.temp

# OS files
.DS_Store
Thumbs.db

# Coverage reports
coverage/
htmlcov/
.coverage

# Package manager caches
.npm/
.yarn/
.pnpm-store/
.mypy_cache/
.pytest_cache/
.nyc_output/
istanbul/
.jest/

# Compression files
*.zip
*.gz
*.tar
*.tgz
*.bz2
*.xz
*.7z
*.rar
*.zst
*.lz4
*.lzh
*.cab
*.arj
*.rpm
*.deb
*.Z
*.lz
*.lzo
*.tar.gz
*.tar.bz2
*.tar.xz
*.tar.zst
```